# Локальные конфиги с реальными ключами/секретами — НИКОГДА не коммитим
*.local.json
configs/*.local.json
secrets/
credentials.txt

# Бэкапы локальных конфигов (upgrade-client.sh: *.local.json.bak.<время>) —
# тоже содержат секреты, не коммитим
*.bak
*.bak.*

# Сертификаты/ключи
*.pem
*.key

# Локальные артефакты рантайма (не коммитим)
*.pf.conf
killswitch.enabled
cache.db

# Имя сервера (личный домен) — не публикуем в репозитории
configs/server-host.txt

# Прочее
.DS_Store
*.log

# Кеш питона от py_compile — в репозиторий не нужен
__pycache__/
*.pyc
